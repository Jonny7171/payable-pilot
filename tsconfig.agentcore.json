{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": false,
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": false,
    "incremental": false,
    "outDir": "agentcore-dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "fixtures/**/*.json"],
  "exclude": ["node_modules", "app", "test", "dist", "agentcore-dist"]
}
